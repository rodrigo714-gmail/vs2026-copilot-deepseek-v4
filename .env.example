# Multi-Provider AI Proxy Configuration
# Configure one or more providers.
# Supported: deepseek, zai, google, openai, nvidia, openrouter, groq, ollama,
#            moonshot, cerebras, zenmux
# Models are auto-discovered from provider catalogs.

PROVIDER_DEEPSEEK_API_KEY=sk-your-deepseek-key-here
PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Uncomment to add more providers:
#PROVIDER_ZAI_API_KEY=your-zai-api-key-here
# PROVIDER_ZAI_BASE_URL defaults to https://api.z.ai/api/paas/v4
#   Z.AI (Zhipu AI / BigModel) - OpenAI-compatible API.
#   glm-5.2 (flagship agentic coding, 1M ctx, $1.40/$4.40 per M tokens)
#   glm-4.7-flash (100% FREE, fast completions)
#   glm-4.7-flashx ($0.07/$0.40, reasoning)
#   GLM Coding Plan: $18/mo unlimited access for Cline/Claude Code
#PROVIDER_MOONSHOT_API_KEY=sk-your-moonshot-key-here
# PROVIDER_MOONSHOT_BASE_URL defaults to https://api.moonshot.ai
#   Kimi models: kimi-k2.7-code ($0.95/$4.00, flagship coding)
#   kimi-k2.7-code-highspeed ($1.90/$8.00, 180 TPS)
#   kimi-k2.6 ($0.95/$4.00)
#   Promo: 20-30% bonus on $100+ top-ups (ends Jul 2, 2026)
#PROVIDER_GOOGLE_API_KEY=your-google-gemini-api-key-here
# PROVIDER_GOOGLE_BASE_URL defaults to https://generativelanguage.googleapis.com
#PROVIDER_OPENAI_API_KEY=sk-your-openai-key-here
#PROVIDER_OPENAI_BASE_URL=https://api.openai.com
#PROVIDER_NVIDIA_API_KEY=nvapi-your-nvidia-key-here
#PROVIDER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com
#PROVIDER_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# PROVIDER_OPENROUTER_BASE_URL defaults to https://openrouter.ai/api
#PROVIDER_GROQ_API_KEY=gsk_your-groq-key-here
# PROVIDER_GROQ_BASE_URL defaults to https://api.groq.com/openai
#PROVIDER_OLLAMACLOUD_API_KEY=your-ollama-cloud-api-key
# PROVIDER_OLLAMA_BASE_URL defaults to https://ollama.com
#PROVIDER_CEREBRAS_API_KEY=csk-your-cerebras-key-here
#PROVIDER_CEREBRAS_BASE_URL=https://api.cerebras.ai
#PROVIDER_ZENMUX_API_KEY=your-zenmux-api-key
# PROVIDER_ZENMUX_BASE_URL defaults to https://zenmux.ai/api

# ─── Free-tier providers ──────────────────────────────────────────
# Quota figures below were researched on 2026-07-31 and change constantly.
# For a Copilot workload the binding limit is usually requests/minute or
# requests/day, NOT the headline token pool.

# Mistral — the largest documented free pool (~1B tokens/month) but only about
# 2 requests/minute, so it works as a fallback for chat, not as a primary for
# completions. Codestral/Devstral may be billed outside the free tier.
# Sign up: https://console.mistral.ai
#PROVIDER_MISTRAL_API_KEY=your-mistral-api-key-here
# PROVIDER_MISTRAL_BASE_URL defaults to https://api.mistral.ai

# SiliconFlow — a few small models are permanently free. Limit is 50 requests/day
# without purchased credit (~1000/day once you buy 10+). The .cn platform needs a
# Chinese phone number; siliconflow.com does not.
# Sign up: https://siliconflow.com
#PROVIDER_SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
# PROVIDER_SILICONFLOW_BASE_URL defaults to https://api.siliconflow.com

# Cloudflare Workers AI — 10,000 neurons/day on the free Workers plan, reset at
# UTC midnight (roughly 200-400 requests/day on a small model).
# BASE_URL IS MANDATORY: it embeds your account id, so there is no usable default
# and the provider is skipped at startup until you set it.
# Sign up: https://dash.cloudflare.com  (Workers AI -> API token)
#PROVIDER_CLOUDFLARE_API_KEY=your-cloudflare-api-token-here
#PROVIDER_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Legacy format (works without PROVIDER_ prefix):
# DEEPSEEK_API_KEY=sk-your-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

DEEPSEEK_MODEL=deepseek-v4-pro
PROXY_PORT=11434
# PROXY_API_KEY=    # optional: set to require auth on the proxy itself

# ─── Logging & Dashboard ──────────────────────────────────────────
# PROXY_LOG_LEVEL=info          # info|debug|warn|error|none
# PROXY_LOG_FILE=               # path to log file (empty = console only)

# ─── Dashboard ─────────────────────────────────────────────────---
# Access real-time usage, cost, and pricing:
#   GET /usage                    Full JSON report with costs & Arena data
#   GET /usage/summary            Text summary for terminal
#   GET /usage/pricing            Full price catalog
#   POST /usage/reset             Reset counters
